# Local PostgreSQL defaults for development.
# Copy this file to .env and change values there if needed.
AUTOTUBE_ENV=development
AUTOTUBE_HTTP_ADDR=:8080

POSTGRES_DB=autotube
POSTGRES_USER=autotube
POSTGRES_PASSWORD=autotube
POSTGRES_PORT=5432

DATABASE_URL=postgres://autotube:autotube@localhost:5432/autotube?sslmode=disable

# Provider secrets are validated when provider-backed workflows are enabled.
# YOUTUBE_API_KEY=
# TRENDS_API_KEY=
# LLM_API_KEY=
# IMAGE_API_KEY=
# VOICE_API_KEY=
