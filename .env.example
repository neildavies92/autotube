# API/worker startup needs no environment file or provider credentials.
# Optional shell exports for the API (files are not loaded automatically):
AUTOTUBE_HOST=127.0.0.1
AUTOTUBE_PORT=8080

# API logging (export in the shell; API does not load .env automatically).
AUTOTUBE_LOG_LEVEL=info

# Optional local PostgreSQL foundation (copy to .env for Compose/DB commands).
# Development-only values; do not reuse them for a public deployment.
POSTGRES_USER=autotube
POSTGRES_PASSWORD=autotube
POSTGRES_DB=autotube
POSTGRES_PORT=55432
DATABASE_URL=postgresql://autotube:autotube@127.0.0.1:55432/autotube

# Dedicated ephemeral test instance; never derives from DATABASE_URL.
TEST_DATABASE_ADMIN_URL=postgresql://autotube_test:autotube_test@127.0.0.1:55433/postgres
