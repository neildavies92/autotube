{
  "name": "autotube",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "dev:api": "pnpm --filter @autotube/api dev",
    "dev:worker": "pnpm --filter @autotube/worker dev",
    "dev:web": "pnpm --filter @autotube/web dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
